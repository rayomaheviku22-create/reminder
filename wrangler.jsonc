{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "followup-tracker",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  // The dashboard UI in ./public is served directly; /api/* falls through to the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "followup_tracker",
      // Paste the id printed by:  npx wrangler d1 create followup_tracker
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],

  "observability": { "enabled": true }
}
