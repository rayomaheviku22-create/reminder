{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "followup-tracker",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  // The dashboard UI in ./public is served directly; /api/* falls through to the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "followup_tracker",
      // Paste your D1 database ID here (Cloudflare dashboard -> D1 -> followup_tracker)
      "database_id": "PASTE_YOUR_DATABASE_ID_HERE"
    }
  ],

  "observability": { "enabled": true }
}
